# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/landslide_db

# JWT
JWT_SECRET_KEY=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# File storage
UPLOAD_DIR=uploads
BASE_URL=http://localhost:8000

# Twilio (optional — leave blank to use mock SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# App
APP_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
